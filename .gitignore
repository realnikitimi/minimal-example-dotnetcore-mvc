```gitignore
# ==========================================
# .NET / ASP.NET Core
# ==========================================

# Build output
[Bb]in/
[Oo]bj/

# Visual Studio cache / user-specific files
.vs/
*.user
*.userosscache
*.suo
*.userprefs

# Visual Studio Code
.vscode/

# Rider / JetBrains
.idea/
*.sln.iml

# Test results
TestResults/
[Tt]est[Rr]esult*/
*.trx

# Coverage
coverage/
.coverage
*.coverage
*.coveragexml

# ==========================================
# NuGet
# ==========================================

*.nupkg
*.snupkg
**/packages/*
!**/packages/build/

# NuGet cache / generated files
project.lock.json
project.fragment.lock.json
artifacts/

# ==========================================
# ASP.NET Core
# ==========================================

# Local configuration / secrets
appsettings.Local.json
appsettings.Development.local.json
appsettings.Development.json

# User secrets
secrets.json

# ASP.NET Core generated files
wwwroot/lib/

# ==========================================
# Entity Framework Core
# ==========================================

# EF tooling generated files
# NOTE: Do NOT ignore Migrations/ if migrations are part of your source control.
# Migrations/

# ==========================================
# Logs
# ==========================================

*.log
logs/
Log/
Logs/

# ==========================================
# OS generated files
# ==========================================

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# ==========================================
# Temporary files
# ==========================================

*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# ==========================================
# Local databases
# ==========================================

*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ==========================================
# Publish output
# ==========================================

publish/
Publish/
*.publishsettings

# ==========================================
# Node / Frontend tooling
# ==========================================

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vite
.vite/

# ==========================================
# Environment variables
# ==========================================

.env
.env.*
!.env.example

# ==========================================
# Docker
# ==========================================

*.pid
docker-compose.override.yml

# ==========================================
# Generated frontend files
# ==========================================

# Uncomment if these are generated by your build
# wwwroot/dist/
# wwwroot/build/
```
/MinimalExample/wwwroot/lib